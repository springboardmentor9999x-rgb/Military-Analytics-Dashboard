{"nbformat":4,"nbformat_minor":0,"metadata":{"colab":{"provenance":[],"authorship_tag":"ABX9TyOvvPxNGj8BtBeTCyileYki"},"kernelspec":{"name":"python3","display_name":"Python 3"},"language_info":{"name":"python"}},"cells":[{"cell_type":"code","source":["import requests\n","import pandas as pd\n","from bs4 import BeautifulSoup\n"],"metadata":{"id":"8L0yRKb3nzAl"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["!git clone https://github.com/Harishini03/Military-Analytics-Dashboard/tree/Harishini_S.git"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"kyI5MP_typha","executionInfo":{"status":"ok","timestamp":1767811842541,"user_tz":-330,"elapsed":421,"user":{"displayName":"Harishini S","userId":"10210156124448013524"}},"outputId":"1201910d-9d3f-4938-a6b1-44f124b9c2cb"},"execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["Cloning into 'Harishini_S'...\n","fatal: repository 'https://github.com/Harishini03/Military-Analytics-Dashboard/tree/Harishini_S.git/' not found\n"]}]},{"cell_type":"code","source":["from google.colab import files\n","files.upload()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":559},"id":"a8R6B64Iqowl","executionInfo":{"status":"ok","timestamp":1767809921046,"user_tz":-330,"elapsed":6803,"user":{"displayName":"Harishini S","userId":"10210156124448013524"}},"outputId":"12438787-fb7d-4ff4-b2d1-753a61f28a0e"},"execution_count":null,"outputs":[{"output_type":"display_data","data":{"text/plain":["<IPython.core.display.HTML object>"],"text/html":["\n","     <input type=\"file\" id=\"files-76a56a64-fe56-4b61-b58a-65889d0b9149\" name=\"files[]\" multiple disabled\n","        style=\"border:none\" />\n","     <output id=\"result-76a56a64-fe56-4b61-b58a-65889d0b9149\">\n","      Upload widget is only available when the cell has been executed in the\n","      current browser session. Please rerun this cell to enable.\n","      </output>\n","      <script>// Copyright 2017 Google LLC\n","//\n","// Licensed under the Apache License, Version 2.0 (the \"License\");\n","// you may not use this file except in compliance with the License.\n","// You may obtain a copy of the License at\n","//\n","//      http://www.apache.org/licenses/LICENSE-2.0\n","//\n","// Unless required by applicable law or agreed to in writing, software\n","// distributed under the License is distributed on an \"AS IS\" BASIS,\n","// WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\n","// See the License for the specific language governing permissions and\n","// limitations under the License.\n","\n","/**\n"," * @fileoverview Helpers for google.colab Python module.\n"," */\n","(function(scope) {\n","function span(text, styleAttributes = {}) {\n","  const element = document.createElement('span');\n","  element.textContent = text;\n","  for (const key of Object.keys(styleAttributes)) {\n","    element.style[key] = styleAttributes[key];\n","  }\n","  return element;\n","}\n","\n","// Max number of bytes which will be uploaded at a time.\n","const MAX_PAYLOAD_SIZE = 100 * 1024;\n","\n","function _uploadFiles(inputId, outputId) {\n","  const steps = uploadFilesStep(inputId, outputId);\n","  const outputElement = document.getElementById(outputId);\n","  // Cache steps on the outputElement to make it available for the next call\n","  // to uploadFilesContinue from Python.\n","  outputElement.steps = steps;\n","\n","  return _uploadFilesContinue(outputId);\n","}\n","\n","// This is roughly an async generator (not supported in the browser yet),\n","// where there are multiple asynchronous steps and the Python side is going\n","// to poll for completion of each step.\n","// This uses a Promise to block the python side on completion of each step,\n","// then passes the result of the previous step as the input to the next step.\n","function _uploadFilesContinue(outputId) {\n","  const outputElement = document.getElementById(outputId);\n","  const steps = outputElement.steps;\n","\n","  const next = steps.next(outputElement.lastPromiseValue);\n","  return Promise.resolve(next.value.promise).then((value) => {\n","    // Cache the last promise value to make it available to the next\n","    // step of the generator.\n","    outputElement.lastPromiseValue = value;\n","    return next.value.response;\n","  });\n","}\n","\n","/**\n"," * Generator function which is called between each async step of the upload\n"," * process.\n"," * @param {string} inputId Element ID of the input file picker element.\n"," * @param {string} outputId Element ID of the output display.\n"," * @return {!Iterable<!Object>} Iterable of next steps.\n"," */\n","function* uploadFilesStep(inputId, outputId) {\n","  const inputElement = document.getElementById(inputId);\n","  inputElement.disabled = false;\n","\n","  const outputElement = document.getElementById(outputId);\n","  outputElement.innerHTML = '';\n","\n","  const pickedPromise = new Promise((resolve) => {\n","    inputElement.addEventListener('change', (e) => {\n","      resolve(e.target.files);\n","    });\n","  });\n","\n","  const cancel = document.createElement('button');\n","  inputElement.parentElement.appendChild(cancel);\n","  cancel.textContent = 'Cancel upload';\n","  const cancelPromise = new Promise((resolve) => {\n","    cancel.onclick = () => {\n","      resolve(null);\n","    };\n","  });\n","\n","  // Wait for the user to pick the files.\n","  const files = yield {\n","    promise: Promise.race([pickedPromise, cancelPromise]),\n","    response: {\n","      action: 'starting',\n","    }\n","  };\n","\n","  cancel.remove();\n","\n","  // Disable the input element since further picks are not allowed.\n","  inputElement.disabled = true;\n","\n","  if (!files) {\n","    return {\n","      response: {\n","        action: 'complete',\n","      }\n","    };\n","  }\n","\n","  for (const file of files) {\n","    const li = document.createElement('li');\n","    li.append(span(file.name, {fontWeight: 'bold'}));\n","    li.append(span(\n","        `(${file.type || 'n/a'}) - ${file.size} bytes, ` +\n","        `last modified: ${\n","            file.lastModifiedDate ? file.lastModifiedDate.toLocaleDateString() :\n","                                    'n/a'} - `));\n","    const percent = span('0% done');\n","    li.appendChild(percent);\n","\n","    outputElement.appendChild(li);\n","\n","    const fileDataPromise = new Promise((resolve) => {\n","      const reader = new FileReader();\n","      reader.onload = (e) => {\n","        resolve(e.target.result);\n","      };\n","      reader.readAsArrayBuffer(file);\n","    });\n","    // Wait for the data to be ready.\n","    let fileData = yield {\n","      promise: fileDataPromise,\n","      response: {\n","        action: 'continue',\n","      }\n","    };\n","\n","    // Use a chunked sending to avoid message size limits. See b/62115660.\n","    let position = 0;\n","    do {\n","      const length = Math.min(fileData.byteLength - position, MAX_PAYLOAD_SIZE);\n","      const chunk = new Uint8Array(fileData, position, length);\n","      position += length;\n","\n","      const base64 = btoa(String.fromCharCode.apply(null, chunk));\n","      yield {\n","        response: {\n","          action: 'append',\n","          file: file.name,\n","          data: base64,\n","        },\n","      };\n","\n","      let percentDone = fileData.byteLength === 0 ?\n","          100 :\n","          Math.round((position / fileData.byteLength) * 100);\n","      percent.textContent = `${percentDone}% done`;\n","\n","    } while (position < fileData.byteLength);\n","  }\n","\n","  // All done.\n","  yield {\n","    response: {\n","      action: 'complete',\n","    }\n","  };\n","}\n","\n","scope.google = scope.google || {};\n","scope.google.colab = scope.google.colab || {};\n","scope.google.colab._files = {\n","  _uploadFiles,\n","  _uploadFilesContinue,\n","};\n","})(self);\n","</script> "]},"metadata":{}},{"output_type":"stream","name":"stdout","text":["Saving links_for_military_data.txt to links_for_military_data (1).txt\n"]},{"output_type":"execute_result","data":{"text/plain":["{'links_for_military_data (1).txt': b'https://www.globalfirepower.com/countries-listing.php\\nhttps://www.globalfirepower.com/total-population-by-country.php\\nhttps://www.globalfirepower.com/available-military-manpower.php\\nhttps://www.globalfirepower.com/manpower-fit-for-military-service.php\\nhttps://www.globalfirepower.com/manpower-reaching-military-age-annually.php\\nhttps://www.globalfirepower.com/active-military-manpower.php\\nhttps://www.globalfirepower.com/active-reserve-military-manpower.php\\nhttps://www.globalfirepower.com/manpower-paramilitary.php\\nhttps://www.globalfirepower.com/aircraft-total.php\\nhttps://www.globalfirepower.com/aircraft-total-fighters.php\\nhttps://www.globalfirepower.com/aircraft-total-attack-types.php\\nhttps://www.globalfirepower.com/aircraft-total-transports.php\\nhttps://www.globalfirepower.com/aircraft-total-trainers.php\\nhttps://www.globalfirepower.com/aircraft-total-special-mission.php\\nhttps://www.globalfirepower.com/aircraft-total-tanker-fleet.php\\nhttps://www.globalfirepower.com/aircraft-helicopters-total.php\\nhttps://www.globalfirepower.com/aircraft-helicopters-attack.php\\nhttps://www.globalfirepower.com/armor-tanks-total.php\\nhttps://www.globalfirepower.com/armor-apc-total.php\\nhttps://www.globalfirepower.com/armor-self-propelled-guns-total.php\\nhttps://www.globalfirepower.com/armor-towed-artillery-total.php\\nhttps://www.globalfirepower.com/armor-mlrs-total.php\\nhttps://www.globalfirepower.com/navy-ships.php\\nhttps://www.globalfirepower.com/navy-force-by-tonnage.php\\nhttps://www.globalfirepower.com/navy-aircraft-carriers.php\\nhttps://www.globalfirepower.com/navy-helo-carriers.php\\nhttps://www.globalfirepower.com/navy-submarines.php\\nhttps://www.globalfirepower.com/navy-destroyers.php\\nhttps://www.globalfirepower.com/navy-frigates.php\\nhttps://www.globalfirepower.com/navy-corvettes.php\\nhttps://www.globalfirepower.com/navy-patrol-coastal-craft.php\\nhttps://www.globalfirepower.com/navy-mine-warfare-craft.php\\nhttps://www.globalfirepower.com/defense-spending-budget.php\\nhttps://www.globalfirepower.com/external-debt-by-country.php\\nhttps://www.globalfirepower.com/purchasing-power-parity.php\\nhttps://www.globalfirepower.com/reserves-of-foreign-exchange-and-gold.php\\nhttps://www.globalfirepower.com/major-serviceable-airports-by-country.php\\nhttps://www.globalfirepower.com/labor-force-by-country.php\\nhttps://www.globalfirepower.com/major-ports-and-terminals.php\\nhttps://www.globalfirepower.com/merchant-marine-strength-by-country.php\\nhttps://www.globalfirepower.com/railway-coverage.php\\nhttps://www.globalfirepower.com/roadway-coverage.php\\nhttps://www.globalfirepower.com/oil-production-by-country.php\\nhttps://www.globalfirepower.com/oil-consumption-by-country.php\\nhttps://www.globalfirepower.com/proven-oil-reserves-by-country.php\\nhttps://www.globalfirepower.com/natural-gas-production-by-country.php\\nhttps://www.globalfirepower.com/natural-gas-consumption-by-country.php\\nhttps://www.globalfirepower.com/proven-natural-gas-reserves-by-country.php\\nhttps://www.globalfirepower.com/coal-production-by-country.php\\nhttps://www.globalfirepower.com/coal-consumption-by-country.php\\nhttps://www.globalfirepower.com/proven-coal-reserves-by-country.php\\nhttps://www.globalfirepower.com/square-land-area.php\\nhttps://www.globalfirepower.com/coastline-coverage.php\\nhttps://www.globalfirepower.com/border-coverage.php\\nhttps://www.globalfirepower.com/waterway-coverage.php\\n'}"]},"metadata":{},"execution_count":12}]},{"cell_type":"code","source":["links = []\n","\n","with open(\"links_for_military_data.txt\", \"r\") as file:\n","    for line in file:\n","        line = line.strip()\n","        if line.startswith(\"http\"):\n","            links.append(line)\n","\n","print(\"Total links:\", len(links))\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"pYDKhHr_q1FR","executionInfo":{"status":"ok","timestamp":1767809921065,"user_tz":-330,"elapsed":18,"user":{"displayName":"Harishini S","userId":"10210156124448013524"}},"outputId":"3561320d-182c-4e64-a12c-19da0558d952"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Total links: 55\n"]}]},{"cell_type":"code","source":["base_url = \"https://www.globalfirepower.com/countries-listing.php\"\n","\n","response = requests.get(base_url, headers={\"User-Agent\": \"Mozilla/5.0\"})\n","soup = BeautifulSoup(response.text, \"html.parser\")\n","\n","countries = []\n","ranks = []\n","\n","boxes = soup.select(\"div.picTrans.recordsetContainer\")\n","\n","for box in boxes:\n","    try:\n","        country = box.find(\n","            \"span\", class_=\"textWhite textLarge textShadow\"\n","        ).text.strip()\n","\n","        rank = box.find(\n","            \"span\", class_=\"textWhite textLarge textBold\"\n","        ).text.strip()\n","\n","        countries.append(country)\n","        ranks.append(rank)\n","    except:\n","        pass\n","\n","data = pd.DataFrame({\n","    \"Country\": countries,\n","    \"Rank\": ranks\n","})\n","\n","print(\"Countries scraped:\", len(data))\n","data.head()\n"],"metadata":{"colab":{"base_uri":"https://localhost:8080/","height":223},"id":"xFvsSDbVq-Lk","executionInfo":{"status":"ok","timestamp":1767809921602,"user_tz":-330,"elapsed":535,"user":{"displayName":"Harishini S","userId":"10210156124448013524"}},"outputId":"ca5d95bd-e2f0-453d-fc29-cd0f74c5e472"},"execution_count":null,"outputs":[{"output_type":"stream","name":"stdout","text":["Countries scraped: 145\n"]},{"output_type":"execute_result","data":{"text/plain":["         Country Rank\n","0  United States    1\n","1         Russia    2\n","2          China    3\n","3          India    4\n","4    South Korea    5"],"text/html":["\n","  <div id=\"df-0b31180e-479e-4e39-9fe8-72a2793ddde7\" clas